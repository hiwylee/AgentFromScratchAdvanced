  "tables": [
    {
      "table_id": "SSB.LINEORDER",
      "role": "fact",
      "priority": "primary",
      "aliases": ["lineorder", "orders", "order lines", "revenue", "sales"],
      "default_measures": ["LO_REVENUE", "LO_EXTENDEDPRICE", "LO_QUANTITY", "LO_DISCOUNT"],
      "default_time_columns": ["LO_ORDERDATE"],
      "common_joins": ["SSB.CUSTOMER", "SSB.PART", "SSB.SUPPLIER", "SSB.DWDATE"],
      "notes": "Primary fact table. Join LO_ORDERDATE to DWDATE.D_DATEKEY for time dimensions. LO_REVENUE = LO_EXTENDEDPRICE * (1 - LO_DISCOUNT/100)."
    },
    {
      "table_id": "SSB.CUSTOMER",
      "role": "dimension",
      "priority": "primary",
      "aliases": ["customer", "customers", "buyer", "buyers"],
      "default_dimensions": ["C_NATION", "C_REGION", "C_CITY", "C_MKTSEGMENT"],
      "common_joins": ["SSB.LINEORDER"],
      "notes": "Use for customer geography (city, nation, region) and market segment analysis. Avoid personal identifiers (C_NAME, C_ADDRESS, C_PHONE)."
    },
    {
      "table_id": "SSB.PART",
      "role": "dimension",
      "priority": "primary",
      "aliases": ["part", "parts", "product", "products", "item", "items"],
      "default_dimensions": ["P_CATEGORY", "P_BRAND1", "P_MFGR", "P_TYPE"],
      "common_joins": ["SSB.LINEORDER"],
      "notes": "Use for product/part category, brand, and manufacturer analysis."
    },
    {
      "table_id": "SSB.SUPPLIER",
      "role": "dimension",
      "priority": "primary",
      "aliases": ["supplier", "suppliers", "vendor", "vendors"],
      "default_dimensions": ["S_NATION", "S_REGION", "S_CITY"],
      "common_joins": ["SSB.LINEORDER"],
      "notes": "Use for supplier geography and supply chain analysis."
    },
    {
      "table_id": "SSB.DWDATE",
      "role": "dimension",
      "priority": "primary",
      "aliases": ["dwdate", "date", "time", "calendar", "month", "year", "quarter"],
      "default_dimensions": ["D_YEAR", "D_MONTH", "D_YEARMONTH", "D_YEARMONTHNUM"],
      "common_joins": ["SSB.LINEORDER"],
      "notes": "Join to LINEORDER via DWDATE.D_DATEKEY = LINEORDER.LO_ORDERDATE. Use D_YEAR, D_MONTH for time-series aggregation."
    }
  ],
