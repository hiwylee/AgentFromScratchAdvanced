{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RollbackPlan",
  "description": "Schema for agent-runtime rollback plan records (schema_version = agent-runtime.rollback-plan.v1).",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "agent-runtime.rollback-plan.v1"
    },
    "candidate_id": {
      "type": "string",
      "description": "Links to the ImprovementCandidateRecord this plan covers."
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/RollbackArtifact"
      }
    },
    "validation_commands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Commands to verify the rollback succeeded."
    },
    "notes": {
      "type": "string",
      "description": "Human notes about the rollback plan."
    }
  },
  "$defs": {
    "RollbackArtifact": {
      "type": "object",
      "required": ["path", "artifact_type", "version_before", "version_after", "rollback_source_path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "artifact_type": {
          "type": "string",
          "enum": ["prompt", "policy", "memory", "eval", "schema_context", "docs"]
        },
        "version_before": {
          "type": "string"
        },
        "version_after": {
          "type": "string"
        },
        "rollback_source_path": {
          "type": "string"
        }
      }
    }
  }
}
