SQLCL_PATH=/home/opc/.local/share/sqlcl/sqlcl/bin/sql

# Oracle ADW admin connection
ADMIN_USER=ADMIN
ADMIN_USER_PASS=

# Oracle ADW working-user connection
DB_USER=
DB_USER_PASS=
DB_DSN=
DB_WALLET_PATH=
DB_WALLET_FILE=
DB_WALLET_PASS=

# Optional live LLM action model. Default runtime remains mock unless the
# provider is set to openai/oci or `agent ask --model-provider ...` is used.
AGENT_MODEL_PROVIDER=mock
LLM=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=30

# OCI Generative AI OpenAI-compatible Responses API.
OCI_BASE_URL=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com/openai/v1
OCI_API_KEY=
OCI_API_KEY_2=
OCI_MODEL=xai.grok-4-1-fast-non-reasoning
OCI_TIMEOUT_SECONDS=30
OCI_PROJECT_OCID=
OCI_CONVERSATION_STORE_ID=

# Optional OCI / service integrations
OCI_API_KEY_OCID=
GEMIMI_API_KEY=
GEMINI_EMBEDDING_MODEL=
N8N_BASE_URL=
N8N_API_KEY=
